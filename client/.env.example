# ---- Identity ----
DEVICE_ID=my-device-01

# Ask the relay operator for this device's token:
#   python -m tools.mint_device_token my-device-01
DEVICE_TOKEN=

# ---- Relay ----
# Base URL of the device endpoint. The agent appends /<DEVICE_ID> so the ingress
# can hash on it and pin this device to one replica.
SERVER_URL=ws://127.0.0.1:8000/device
# Trust a self-signed relay certificate. Only meaningful for wss://.
WS_INSECURE_TLS=false

# ---- Reconnection ----
# Base delay; it doubles per consecutive failure up to RECONNECT_MAX_INTERVAL,
# with jitter, so a fleet coming back after an outage does not stampede.
RECONNECT_INTERVAL=5
RECONNECT_MAX_INTERVAL=60
# Wait after a refused handshake. A revoked token does not improve by retrying.
RECONNECT_AUTH_INTERVAL=300

# ---- Terminal ----
# Empty means $SHELL, then the first of /bin/bash, /bin/ash, /bin/sh that exists.
SHELL_COMMAND=
# Print the distro login banner when there is one.
SHELL_MOTD=true
MAX_SESSIONS=10

# ---- Transfers ----
# Directories the relay may read from and write to, comma separated. Everything
# outside is refused, so a compromised relay cannot drop a file into /etc/cron.d
# or read this device's private keys. Use "/" to allow the whole filesystem.
ALLOWED_ROOTS=~
MAX_FILE_SIZE=104857600
CHUNK_SIZE=65536

# ---- Process ----
LOG_LEVEL=INFO
