# ---- Where the relay is ----
# Reached by THIS PROCESS, server-to-server (device list, device tokens).
# Internal name in compose/Kubernetes.
RELAY_URL=http://localhost:8000

# Reached by the BROWSER, for WebSockets. Must resolve from the user's machine,
# and in Kubernetes must be the ingress host — only the ingress applies the
# device-id hash that lands the upgrade on the right pod.
RELAY_WS_URL=ws://localhost:8000

# ---- Trust with the relay ----
# MUST be the identical value in server/.env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SECRET=

# ---- Database: users and the device registry ----
# docker-compose.yml already points this at its own postgres service; set it here
# only when running the frontend outside compose.
DATABASE_URL=postgresql+asyncpg://wdc:wdc@localhost:5432/wdc

# ---- Publishing device revocations to the relay ----
# The same Redis the relay uses. Leave empty and revocations are stored in the
# database but never reach the relay, so a revoked device keeps connecting.
REDIS_URL=redis://localhost:6379/0

# ---- Sessions ----
# Signs the HttpOnly session cookie. Independent of RELAY_SECRET.
SESSION_SECRET=
SESSION_TTL=43200
GRANT_TTL=30
# Set true once served over HTTPS, so the cookie is not sent in the clear.
COOKIE_SECURE=false

# ---- First administrator ----
# Used ONCE, to seed the account when the users table is empty. After that,
# accounts are managed in the UI and these are ignored — so rotating the hash
# here cannot reset a password that has since been changed.
ADMIN_USERNAME=admin
# Generate with: python -m tools.hash_password
# Left empty, a built-in development hash for the password "admin" is used.
ADMIN_PASSWORD_HASH=

APP_NAME=Device Connections
LOG_LEVEL=INFO

# Fuso usado para exibir datas nas páginas. As datas são gravadas em UTC; isto é
# só apresentação. Antes quem formatava era o navegador, no fuso de cada máquina —
# agora sai do servidor, então a mesma linha se lê igual para o time inteiro.
DISPLAY_TZ=America/Sao_Paulo
