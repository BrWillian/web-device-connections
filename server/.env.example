# ---- Process ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Identifies the replica. In Kubernetes, feed from the downward API (metadata.name).
POD_NAME=local

# ---- Shared state (required to run more than one replica) ----
# Leave empty for single-process local development.
REDIS_URL=redis://localhost:6379/0
PRESENCE_TTL=30

# ---- Trust with the frontend ----
# MUST be the identical value in frontend/.env. The frontend signs a grant for
# each WebSocket upgrade; the relay verifies it with this secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SECRET=

# ---- Device trust ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then mint per-device tokens: python -m tools.mint_device_token device-01
DEVICE_MASTER_SECRET=

# Accept unauthenticated devices on the legacy /device route during a fleet
# migration only. Devices on that route cannot be hashed to a stable pod.
ALLOW_LEGACY_DEVICES=false

# Origins allowed to open a WebSocket, comma-separated. Empty disables the check.
# WebSockets are not covered by CORS, so this is the equivalent guard.
ALLOWED_ORIGINS=http://localhost:3000

# ---- Transfers ----
MAX_FILE_SIZE=104857600
CHUNK_SIZE=65536
SESSION_TIMEOUT=3600
MAX_SESSIONS_PER_DEVICE=10
